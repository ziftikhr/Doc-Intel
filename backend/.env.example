# Copy to .env and fill in. .env is git-ignored.
# Both keys are optional: without one, extraction uses text rules only and search
# uses an offline embedder. A Gemini key (free at https://aistudio.google.com/apikey)
# enables AI extraction and semantic search.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# DOCINTEL_LLM_PROVIDER=auto          # auto (Gemini if its key is set) | openai | gemini | none
# DOCINTEL_LLM_MODEL=                 # empty = gpt-5.4-mini / gemini-3.5-flash
# DOCINTEL_LLM_REASONING_EFFORT=low   # set empty for non-reasoning models (gpt-4.1, gpt-4o)
# DOCINTEL_LLM_CONCURRENCY=4

# PostgreSQL + pgvector (started with: docker compose up -d)
POSTGRES_DB=docintel
POSTGRES_USER=docintel
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://docintel:change-me@127.0.0.1:5433/docintel

# API / worker (defaults shown)
# DOCINTEL_STORAGE_DIR=storage          # uploaded originals
# DOCINTEL_MAX_UPLOAD_MB=50
# DOCINTEL_API_KEY=                     # set to require an X-API-Key header on /api
# DOCINTEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DOCINTEL_INLINE_WORKER=true           # background worker inside `docintel serve`
# DOCINTEL_WORKER_THREADS=1
# DOCINTEL_EMBEDDING_PROVIDER=auto      # auto (gemini if key set, else offline hashing) | gemini | hashing | none
# DOCINTEL_EMBEDDING_MODEL=gemini-embedding-001
